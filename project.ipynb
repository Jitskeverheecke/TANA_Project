    "sigma_r2 = np.zeros(n_vbins)\n",
    "sigma_phi2 = np.zeros(n_vbins)\n",
    "sigma_theta2 = np.zeros(n_vbins)\n",
    "\n",
    "v_mean_r= np.zeros(n_vbins)\n",
    "v_mean_phi= np.zeros(n_vbins)\n",
    "v_mean_theta = np.zeros(n_vbins)\n",
    "\n",
    "L_mean = np.zeros(n_vbins)\n",
    "\n",
    "for i in range(n_vbins):\n",
    "    #print(i)\n",
    "    mask = (r >= vbins[i]) & (r < vbins[i+1])\n",
    "    if np.any(mask):\n",
    "        sigma_r2[i] = np.var(v_r[mask].to(km/s).value, ddof=1)\n",
    "        sigma_phi2[i] = np.var(v_phi[mask].to(km/s).value, ddof=1)\n",
    "        sigma_theta2[i] = np.var(v_theta[mask].to(km/s).value, ddof=1)\n",
    "        v_mean_r[i] = np.mean(v_r[mask].to(km/s).value)\n",
    "        v_mean_phi[i] = np.mean(v_phi[mask].to(km/s).value)\n",
    "        v_mean_theta[i] = np.mean(v_theta[mask].to(km/s).value)\n",
    "\n",
    "sigma_r2 *=(km**2/s**2)\n",
    "sigma_phi2 *=(km**2/s**2)\n",
    "sigma_theta2 *=(km**2/s**2)\n",
    "v_mean_r *=(km/s)\n",
    "v_mean_phi *=(km/s)\n",
    "v_mean_theta *=(km/s)\n",
    "\n",
    "beta_phi = 1 - sigma_phi2[:-1]/sigma_r2[:-1]\n",
    "beta_theta = 1 - sigma_theta2[:-1]/sigma_r2[:-1]"
   ]
  },
