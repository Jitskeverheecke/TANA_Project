\providecommand\hyper@newdestlabel[2]{}
\@writefile{toc}{\contentsline {chapter}{\numberline {2}Statistical analysis of galaxies from a cosmological simulation}{7}{chapter.2}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces Density contrast of a subhalo extracted from the TNG100 data set. The three panels show the density contrast in the xy-, xz- and yz- planes respectively. The color bar indicates the value of the density contrast $\delta $. Above distributions of $\delta $ resembles all subhalos in the TNG100 simulation box, whether they host a galaxy or not.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:subhalo_all_density_contrast}{{2.1}{7}{Density contrast of a subhalo extracted from the TNG100 data set. The three panels show the density contrast in the xy-, xz- and yz- planes respectively. The color bar indicates the value of the density contrast $\delta $. Above distributions of $\delta $ resembles all subhalos in the TNG100 simulation box, whether they host a galaxy or not}{figure.caption.9}{}}
\newlabel{fig:subhalo_all_density_contrast@cref}{{[figure][1][2]2.1}{[1][7][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Density contrast of galaxy hosting subhalo extracted from the TNG100 data set. The three panels show the density contrast in the xy-, xz- and yz- planes respectively. The color bar indicates the value of the density contrast $\delta $.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:subhalo_density_contrast}{{2.2}{8}{Density contrast of galaxy hosting subhalo extracted from the TNG100 data set. The three panels show the density contrast in the xy-, xz- and yz- planes respectively. The color bar indicates the value of the density contrast $\delta $}{figure.caption.10}{}}
\newlabel{fig:subhalo_density_contrast@cref}{{[figure][2][2]2.2}{[1][7][]8}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces Two-point correlation function $\xi (r)$ of subhalos hosting galaxies. The red line indicates a power-law fit to the data points, with parameters $r_0 = 36.60$ Mpc and $\gamma = 1.09$. Deviation from the power-law for $r \approxeq 1$ Mpc can be observed.}}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:two_point_correlation}{{2.3}{8}{Two-point correlation function $\xi (r)$ of subhalos hosting galaxies. The red line indicates a power-law fit to the data points, with parameters $r_0 = 36.60$ Mpc and $\gamma = 1.09$. Deviation from the power-law for $r \approxeq 1$ Mpc can be observed}{figure.caption.11}{}}
\newlabel{fig:two_point_correlation@cref}{{[figure][3][2]2.3}{[1][7][]8}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.4}{\ignorespaces Scattered stellar mass vs subhalo mass. The red dashed line indicates a linear relation with a slope of $f_\text  {b} = 0.157$. The expresses a theoretical upper limit for the stellar mass that can be contained in a halo. Here it can be observed that some subhalos host galaxies with stellar mass exceeding this limit.}}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:stellar_vs_subhalo_mass}{{2.4}{8}{Scattered stellar mass vs subhalo mass. The red dashed line indicates a linear relation with a slope of $f_\text {b} = 0.157$. The expresses a theoretical upper limit for the stellar mass that can be contained in a halo. Here it can be observed that some subhalos host galaxies with stellar mass exceeding this limit}{figure.caption.11}{}}
\newlabel{fig:stellar_vs_subhalo_mass@cref}{{[figure][4][2]2.4}{[1][7][]8}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.5}{\ignorespaces Star formation rate scattered as function of stellar mass. The color bar indicates the logarithm of the black hole mass contained in the host subhalo. A linear trend can be observed where higher stellar mass corresponds to a higher star formation rate while at the same time, the black hole mass increases with increasing stellar mass.}}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:SFR_vs_stellar_mass}{{2.5}{9}{Star formation rate scattered as function of stellar mass. The color bar indicates the logarithm of the black hole mass contained in the host subhalo. A linear trend can be observed where higher stellar mass corresponds to a higher star formation rate while at the same time, the black hole mass increases with increasing stellar mass}{figure.caption.12}{}}
\newlabel{fig:SFR_vs_stellar_mass@cref}{{[figure][5][2]2.5}{[1][7][]9}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.6}{\ignorespaces Black hole mass scattered as function of stellar mass. A clear correlation can be observed where higher stellar mass corresponds to higher black hole mass.}}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:BH_vs_stellar_mass}{{2.6}{9}{Black hole mass scattered as function of stellar mass. A clear correlation can be observed where higher stellar mass corresponds to higher black hole mass}{figure.caption.12}{}}
\newlabel{fig:BH_vs_stellar_mass@cref}{{[figure][6][2]2.6}{[1][7][]9}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.7}{\ignorespaces Scattered black hole mass versus velocity dispersion. A clear correlation can be observed where higher velocity dispersion corresponds to higher black hole mass. This trend is in agreement with notion where the circular velocity is a proxy for the bulge mass of a galaxy, which in turn correlates with the black hole mass at the center of the galaxy.}}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:SubhaloBHMassvsVelocityDispersion}{{2.7}{9}{Scattered black hole mass versus velocity dispersion. A clear correlation can be observed where higher velocity dispersion corresponds to higher black hole mass. This trend is in agreement with notion where the circular velocity is a proxy for the bulge mass of a galaxy, which in turn correlates with the black hole mass at the center of the galaxy}{figure.caption.13}{}}
\newlabel{fig:SubhaloBHMassvsVelocityDispersion@cref}{{[figure][7][2]2.7}{[1][7][]9}{}{}{}}
