  },
  {
   "cell_type": "code",
   "execution_count": 68,
   "id": "e01dfb56",
   "metadata": {},
   "outputs": [],
   "source": [
    "def rho_plummer(r, b, rho0):\n",
    "    r_b = r/b\n",
    "    return rho0*(1 + r_b**2)**(-5/2)\n",
    "\n",
    "def log_rho_plummer(r, b, rho0):\n",
    "    return np.log10(rho_plummer(r, b, rho0))\n",
    "\n",
    "def rho_Hernquist(r, b, rho0):\n",
    "    r_b = r/b\n",
    "    return rho0/(4*np.pi*b**3*r_b*(1 + r_b)**3)\n",
    "\n",
    "def log_rho_Hernquist(r, b, rho0):\n",
    "    return np.log10(rho_Hernquist(r, b, rho0))\n",
    "\n",
    "def rho_NFW(r, b, rho0):\n",
    "    r_b = r/b\n",
    "    return rho0/(4*np.pi*b**3*r_b*(1 + r_b)**2)\n",
    "\n",
    "def log_rho_NFW(r, b, rho0):\n",
    "    return np.log10(rho_NFW(r, b, rho0))\n",
    "\n",
    "def rho_Einasto(r,b,n, rho0):\n",
    "    r_b = r/b\n",
    "    return rho0 * np.exp( - (2*n) * (r_b**(1/n) - 1) )\n",
    "\n",
    "def log_rho_Einasto(r, b, n, rho0):\n",
    "    return np.log(rho_Einasto(r, b, n, rho0))\n",
    "\n",
    "def rho_cored_DEHNEN(r, b, rho0):\n",
    "    r_b = r/b\n",
    "    return rho0/(12*np.pi*b**3*(1 + r_b)**4)\n",
    "\n",
    "def log_rho_cored_DEHNEN(r, b, rho0):\n",
    "    return np.log10(rho_cored_DEHNEN(r, b, rho0))\n",
