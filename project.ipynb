  {
   "cell_type": "markdown",
   "id": "49eda252",
   "metadata": {},
   "source": [
    "## Phase space distribution (we beschouwen dit best ook?)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "2e790095",
   "metadata": {},
   "outputs": [],
   "source": [
    "#phase_space = np.vstack((xyz.T.value, vxyz.T.value)).T\n",
    "#phase_space.shape"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ccb87f3e",
   "metadata": {},
   "source": [
    "### Test spherical symmetry of the system"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "43a70665",
   "metadata": {},
   "source": [
    "Inpirated by [this post](https://scipython.com/books/book2/chapter-8-scipy/examples/visualizing-the-spherical-harmonics/)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "id": "dda0f0d2",
   "metadata": {},
   "outputs": [],
   "source": [
    "from scipy.special import sph_harm_y"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "efbdb49a",
   "metadata": {},
   "outputs": [],
   "source": [
    "#examine sphericity of the system in spherical coordinates\n",
    "theta = np.arccos(z / r)\n",
    "phi_angle = np.mod(np.arctan2(y.value, x.value), 2*np.pi)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "33b6c1f3",
   "metadata": {},
   "outputs": [],
   "source": [
    "n_ = 200\n",
    "H, theta_edges, phi_edges = np.histogram2d(theta, phi_angle, bins=[n_, n_], density=True)\n",
    "theta_j = 1/2*(n_)*(theta_edges[:-1] + theta_edges[1:])\n",
    "phi_j   = 1/2*(n_)*(phi_edges[:-1] + phi_edges[1:])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "8aba97aa",
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.ticker as ticker"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "id": "4d81d568",
   "metadata": {},
   "outputs": [],
   "source": [
    "theta_mesh, phi_mesh = np.meshgrid(theta_edges, phi_edges, indexing='ij')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "c862b902",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 600x400 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.close('all')\n",
    "plt.figure(figsize=(6, 4))\n",
    "im = plt.pcolormesh(phi_mesh.value, theta_mesh.value, H.value, shading='auto', cmap='bwr')\n",
    "plt.colorbar(im, label=r'Density $[\\text{rad}^{-2}]$')\n",
    "plt.xlabel(r'$\\phi \\, [rad]$')\n",
    "plt.ylabel(r'$\\theta \\, [rad]$')\n",
    "plt.title('2D Histogram in Spherical Coordinates')\n",
    "\n",
    "ticksx = np.arange(0, 2*np.pi + 0.1, np.pi/2)\n",
    "ticksy = np.arange(0, np.pi + 0.1, np.pi/2)\n",
    "labelsx = [r'$0$', r'$\\frac{\\pi}{2}$', r'$\\pi$', r'$\\frac{3\\pi}{2}$', r'$2\\pi$']\n",
    "labelsy = [r'$0$', r'$\\frac{\\pi}{2}$', r'$\\pi$']\n",
    "plt.xticks(ticksx, labelsx)\n",
    "plt.yticks(ticksy, labelsy)\n",
    "\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('Figures/2D_Histogram_Spherical_Coordinates.pdf', bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 55,
   "id": "97f03f02",
   "metadata": {},
   "outputs": [],
   "source": [
    "n_bins = 28\n",
    "r_min, r_max = r.min(), r.max()\n",
    "#radial_edges = np.linspace(r_min, r_max, n_bins+1)\n",
    "radial_edges = np.logspace(np.log10(r_min.value), np.log10(r_max.value), n_bins+1)\n",
    "r_j = 1/2 * (radial_edges[1:] + radial_edges[:-1])\n",
    "\n",
    "def alm(l,m,phi,theta, radial_edges, r):\n",
    "    alm_r = np.zeros(n_bins, dtype=complex)\n",
    "    for j in range(n_bins):\n",
    "        r_lo, r_hi = radial_edges[j], radial_edges[j+1]\n",
    "        mask = (r >= r_lo) & (r < r_hi)\n",
    "\n",
    "        if np.sum(mask) == 0:\n",
    "            continue\n",
    "\n",
    "        theta_shell = theta[mask]\n",
    "        phi_shell = phi[mask]\n",
    "\n",
    "        alm_r[j] = np.sum(sph_harm_y(l, m, phi_shell.value, theta_shell.value))\n",
    "    return alm_r"
   ]
  },
