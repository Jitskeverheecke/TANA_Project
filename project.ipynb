       "<Figure size 600x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.close('all')\n",
    "fig = plt.figure(figsize=(6, 4))\n",
    "plt.scatter(r.value, -E.value, s=1, alpha=0.25)\n",
    "plt.xlabel(r'$r\\, [\\text{kpc}]$')\n",
    "plt.ylabel(r'$-\\text{E} \\, [\\frac{\\text{km} \\text{M}_\\odot}{\\text{s}^2}]$')\n",
    "plt.title('Binding Energy Distribution')\n",
