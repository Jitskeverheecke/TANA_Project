   "id": "0584a4b6",
   "metadata": {},
   "outputs": [],
   "source": [
    "N_dm_particles = data[\"Header\"].attrs['NumPart_ThisFile'][1] #number of dark matter particles\n",
    "mass_darkm = data[\"Header\"].attrs['MassTable'][1] #mass of each dark matter particle in 1e10 solar masses/h\n",
    "Box_size = data[\"Header\"].attrs['BoxSize'] #cubic box size\n",
    "z_redshift = data[\"Header\"].attrs['Redshift'] #redshift\n",
    "a = data[\"Header\"].attrs['Time'] #scale factor"
   ]
  },
  {
   "cell_type": "code",
