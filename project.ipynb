   "metadata": {},
   "outputs": [],
   "source": [
    "Omega_m, Omega_Lambda, Omega_b, h = data[\"Header\"].attrs['Omega0'], data[\"Header\"].attrs['OmegaLambda'], data[\"Header\"].attrs['OmegaBaryon'], data[\"Header\"].attrs['HubbleParam']"
   ]
  },
  {
   "cell_type": "code",
