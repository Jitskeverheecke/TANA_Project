\@writefile{toc}{\contentsline {chapter}{\numberline {2}Statistical analysis of galaxies from a cosmological simulation}{7}{chapter.2}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces Density contrast of a subhalo extracted from the TNG100 data set. The three panels show the density contrast in the xy-, xz- and yz- planes respectively. The color bar indicates the value of the density contrast $\delta $. Above distributions of $\delta $ resembles all subhalos in the TNG100 simulation box, whether they host a galaxy or not.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:placeholder}{{2.1}{7}{Density contrast of a subhalo extracted from the TNG100 data set. The three panels show the density contrast in the xy-, xz- and yz- planes respectively. The color bar indicates the value of the density contrast $\delta $. Above distributions of $\delta $ resembles all subhalos in the TNG100 simulation box, whether they host a galaxy or not}{figure.caption.9}{}}
\newlabel{fig:placeholder@cref}{{[figure][1][2]2.1}{[1][7][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Two-point correlation function $\xi (r)$ of subhalos hosting galaxies. The red line indicates a power-law fit to the data points, with parameters $r_0 = 36.60$ Mpc and $\gamma = 1.09$. Deviation from the power-law for $r \approxeq 1$ Mpc can be observed.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:two_point_correlation}{{2.2}{8}{Two-point correlation function $\xi (r)$ of subhalos hosting galaxies. The red line indicates a power-law fit to the data points, with parameters $r_0 = 36.60$ Mpc and $\gamma = 1.09$. Deviation from the power-law for $r \approxeq 1$ Mpc can be observed}{figure.caption.10}{}}
\newlabel{fig:two_point_correlation@cref}{{[figure][2][2]2.2}{[1][7][]8}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces Scattered stellar mass vs subhalo mass. The red dashed line indicates a linear relation with a slope of $f_\text  {b} = 0.157$. The expresses a theoretical upper limit for the stellar mass that can be contained in a halo. Here it can be observed that some subhalos host galaxies with stellar mass exceeding this limit.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:stellar_vs_subhalo_mass}{{2.3}{8}{Scattered stellar mass vs subhalo mass. The red dashed line indicates a linear relation with a slope of $f_\text {b} = 0.157$. The expresses a theoretical upper limit for the stellar mass that can be contained in a halo. Here it can be observed that some subhalos host galaxies with stellar mass exceeding this limit}{figure.caption.10}{}}
\newlabel{fig:stellar_vs_subhalo_mass@cref}{{[figure][3][2]2.3}{[1][7][]8}{}{}{}}
