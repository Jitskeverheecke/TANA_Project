\@writefile{lof}{\contentsline {figure}{\numberline {1.7}{\ignorespaces Orbits of a test particles initialized at a distance of $r_0 = 8$ kpc from the center of mass of the system with different initial circular velocity. The stable orbit (blue) corresponds to the circular velocity at this radius, while the other orbits (orange and green) show precessing rosette patterns due to their lower and higher initial velocity, respectively. The potential used for the orbit integration is the fitted Einasto potential of the system.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:orbits_in_einasto_potential}{{1.7}{6}{Orbits of a test particles initialized at a distance of $r_0 = 8$ kpc from the center of mass of the system with different initial circular velocity. The stable orbit (blue) corresponds to the circular velocity at this radius, while the other orbits (orange and green) show precessing rosette patterns due to their lower and higher initial velocity, respectively. The potential used for the orbit integration is the fitted Einasto potential of the system}{figure.caption.8}{}}
\newlabel{fig:orbits_in_einasto_potential@cref}{{[figure][7][1]1.7}{[1][6][]6}{}{}{}}
